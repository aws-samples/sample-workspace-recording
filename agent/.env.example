# Copy this file to agent/.env and replace values for your AWS environment.
# agent/.env and the generated config.runtime.json are ignored by Git.

WSREC_S3_BUCKET=replace-with-your-recordings-bucket
WSREC_REGION=us-east-1
WSREC_FFMPEG_PATH=C:\wsrec\ffmpeg\bin\ffmpeg.exe
WSREC_AWS_PATH=C:\Program Files\Amazon\AWSCLIV2\aws.exe
WSREC_AWS_PROFILE=appstream_machine_role
WSREC_SCRIPTS_PREFIX=agent-scripts
WSREC_LOCAL_DIR=C:\wsrec\buffer
WSREC_PSEXEC_PATH=C:\wsrec\bin\PsExec64.exe
WSREC_FRAME_RATE=6
WSREC_SEGMENT_SECONDS=60
WSREC_IDLE_THRESHOLD_SECONDS=60
WSREC_POLL_SECONDS=5
WSREC_QUIET_SECONDS=30
WSREC_SSE_KMS=true
# May be empty when the bucket default KMS key should be used.
WSREC_KMS_KEY_ID=
